{
  "name": "data-science-customer-churn",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@serverless/safeguards-plugin": "^1.2.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "serverless-deployment-bucket": "^1.6.0",
    "serverless-s3-sync": "^3.5.1"
  },
  "scripts": {
    "deploy-data:dev": "cd serverless/data; sls deploy",
    "deploy-data:test": "cd serverless/data; sls deploy --stage test",
    "deploy-data:prod": "cd serverless/data; sls deploy --stage prod",
    "deploy-image:dev": "cd serverless/image; sls deploy",
    "deploy-image:test": "cd serverless/image; sls deploy --stage test",
    "deploy-image:prod": "cd serverless/image; sls deploy --stage prod",
    "image:push": "container/build-push.sh",
    "image:build-local": "docker build -f container/Dockerfile -t customer-churn-model:local .",
    "deploy-pipeline:dev": "cd serverless/pipeline; sls deploy",
    "deploy-pipeline:test": "cd serverless/pipeline; sls deploy --stage test",
    "deploy-pipeline:prod": "cd serverless/pipeline; sls deploy --stage prod",
    "deploy-endpoint:dev": "cd serverless/endpoint; sls deploy",
    "deploy-endpoint:test": "cd serverless/endpoint; sls deploy --stage test",
    "deploy-endpoint:prod": "cd serverless/endpoint; sls deploy --stage prod",
    "deploy-batch:dev": "cd serverless/batch; sls deploy",
    "deploy-batch:test": "cd serverless/batch; sls deploy --stage test",
    "deploy-batch:prod": "cd serverless/batch; sls deploy --stage prod",
    "ingest": "cd serverless/data; sls invoke -f IngestDataset --log",
    "ingest:drift": "cd serverless/data; sls invoke -f IngestDataset --log --data '{\"simulate_drift\": true}'",
    "pipeline:start": "aws sagemaker start-pipeline-execution --pipeline-name customer-churn-training --pipeline-execution-display-name manual-$(date +%Y%m%d-%H%M%S)",
    "pipeline:executions": "aws sagemaker list-pipeline-executions --pipeline-name customer-churn-training --max-results 5",
    "models": "python3 -m src.scripts.approve_model",
    "batch:run": "cd serverless/batch; sls invoke -f BatchScoring --log",
    "local:download": "python3 -m src.scripts.download_dataset",
    "local:train": "python3 -m src.scripts.train_local",
    "test": "python3 -m pytest",
    "format": "prettier --write . && yapf -i -r src tests && python3 -m isort src tests",
    "format:check": "prettier --check . && yapf --diff -r src tests && python3 -m isort --check-only src tests",
    "lint": "pylint src tests && eslint serverless container"
  },
  "author": "Sebastian Torres",
  "license": "ISC"
}
