Dx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="70" y="869" /></Array></mxGeometry></mxCell><mxCell id="infra-35" edge="1" parent="infra-studio" source="infra-32" target="infra-7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.02;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="infra-36" parent="infra-studio" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud;strokeColor=default;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;labelBackgroundColor=none;fontFamily=Verdana;dashed=1;dashPattern=8 8;" value="Cloud Formation&lt;br&gt;VPC" vertex="1"><mxGeometry x="360" y="830" width="270" height="180" as="geometry" /></mxCell><mxCell id="infra-37" parent="infra-studio" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc2;strokeColor=#8C4FFF;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#AAB7B8;dashed=0;fontFamily=Verdana;" value="VPC&lt;br&gt;(app subnets)" vertex="1"><mxGeometry x="400" y="890" width="190" height="90" as="geometry" /></mxCell><mxCell id="infra-38" parent="infra-studio" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;⓫&lt;/font&gt;" vertex="1"><mxGeometry x="560" y="860" width="48" height="52" as="geometry" /></mxCell><mxCell id="infra-39" edge="1" parent="infra-studio" source="infra-32" target="infra-37" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="869" /><mxPoint x="320" y="935" /></Array></mxGeometry></mxCell><mxCell id="infra-info" parent="infra-0" value="infra-info" /><mxCell id="infra-infobox" parent="infra-info" style="text;html=1;spacing=20;spacingTop=-30;whiteSpace=wrap;overflow=hidden;rounded=1;fontSize=12;fontFamily=Helvetica;fillColor=#7EA6E0;strokeColor=none;arcSize=4;glass=0;shadow=0;opacity=25;" value="&lt;h1 style=&quot;line-height: 120%;&quot;&gt;&lt;font face=&quot;Verdana&quot; style=&quot;font-size: 18px;&quot;&gt;Data Science Infrastructure&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;text-align: justify; line-height: 120%;&quot;&gt;&lt;font face=&quot;Verdana&quot;&gt;&lt;p&gt;Shared platform of the &lt;b&gt;data-science&lt;/b&gt; MLOps repository. It has no application code: it creates the resources every MLOps project needs and publishes their names, so each project only has to deploy its own stacks. It lives in the &lt;b&gt;Common Infrastructure&lt;/b&gt; stack, plus the &lt;b&gt;SageMaker Studio&lt;/b&gt; stack and the &lt;b&gt;VPC&lt;/b&gt; it runs in.&lt;/p&gt;&lt;p&gt;The &lt;b&gt;MLOps team&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➊&lt;/font&gt; develops and operates the &lt;b&gt;MLOps projects&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➋&lt;/font&gt; (today, Customer Churn). When a project is deployed it reads from &lt;b&gt;SSM Parameters&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➌&lt;/font&gt; the names of the shared resources, so no project hard-codes them.&lt;/p&gt;&lt;p&gt;The &lt;b&gt;Data Lake Bucket&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➍&lt;/font&gt; is split into zones per project: raw data as it arrives, curated data ready for analytics and machine learning, and the predictions produced by the models. Every new object is announced to &lt;b&gt;EventBridge&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➎&lt;/font&gt;, so projects can start their data pipelines as soon as new data lands without configuring anything on the bucket.&lt;/p&gt;&lt;p&gt;The &lt;b&gt;Artifacts Bucket&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➏&lt;/font&gt; keeps everything machine learning produces: training datasets, models, evaluation reports, monitoring baselines and the traffic captured from endpoints. Both buckets are versioned so every registered model stays reproducible.&lt;/p&gt;&lt;p&gt;Analysts and projects query the data lake through the shared &lt;b&gt;Athena Workgroup&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➐&lt;/font&gt;, which enforces a scan limit per query and stores results in the &lt;b&gt;Athena Results Bucket&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➑&lt;/font&gt;, where they expire automatically.&lt;/p&gt;&lt;p&gt;The &lt;b&gt;Notifications Topic&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➒&lt;/font&gt; is the single channel for people: pipeline failures, models waiting for approval, approved models and endpoint or data drift alarms published by the projects reach the team by email.&lt;/p&gt;&lt;p&gt;&lt;b&gt;SageMaker Studio&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➓&lt;/font&gt; gives the team a web interface over the same resources to follow pipeline executions, approve models in the registry and inspect endpoints and monitoring reports.&lt;/p&gt;&lt;p&gt;Studio keeps each user's files on a disk it mounts through the &lt;b&gt;VPC&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;⓫&lt;/font&gt;, created with a vendored VPC library. Studio reaches the internet and AWS through SageMaker's own network, so the VPC needs no NAT gateways; no other piece of the projects runs inside it.&lt;/p&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="1480" y="40" width="720" height="530" as="geometry" /></mxCell></root></mxGraphModel></diagram>
