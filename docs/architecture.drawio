,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;fontFamily=Verdana;" value="Registry&lt;br&gt;Rules" vertex="1"><mxGeometry x="1740" y="380" width="78" height="78" as="geometry" /></mxCell><mxCell id="churn-train-53" parent="churn-train-governance" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;⓯&lt;/font&gt;" vertex="1"><mxGeometry x="1810" y="350" width="48" height="52" as="geometry" /></mxCell><mxCell id="churn-train-54" parent="churn-train-governance" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fontFamily=Verdana;" value="OnModelApproved&lt;br&gt;Lambda" vertex="1"><mxGeometry x="1980" y="380" width="78" height="78" as="geometry" /></mxCell><mxCell id="churn-train-55" parent="churn-train-governance" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;⓱&lt;/font&gt;" vertex="1"><mxGeometry x="2050" y="350" width="48" height="52" as="geometry" /></mxCell><mxCell id="churn-train-56" parent="churn-train-governance" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud;strokeColor=default;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;labelBackgroundColor=none;fontFamily=Verdana;dashed=1;dashPattern=8 8;" value="Customer Churn&lt;br&gt;Pipeline" vertex="1"><mxGeometry x="2190" y="610" width="190" height="180" as="geometry" /></mxCell><mxCell id="churn-train-57" parent="churn-train-governance" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.systems_manager;fontFamily=Verdana;" value="Deployment&lt;br&gt;Contract (SSM)" vertex="1"><mxGeometry x="2240" y="660" width="78" height="78" as="geometry" /></mxCell><mxCell id="churn-train-58" parent="churn-train-governance" style="text;whiteSpace=wrap;html=1;fontFamily=Verdana;" value="&lt;font style=&quot;font-size: 25px; color: rgb(103, 171, 159);&quot;&gt;⓲&lt;/font&gt;" vertex="1"><mxGeometry x="2310" y="630" width="48" height="52" as="geometry" /></mxCell><mxCell id="churn-train-59" edge="1" parent="churn-train-governance" source="churn-train-43" target="churn-train-50" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="churn-train-60" edge="1" parent="churn-train-governance" source="churn-train-50" target="churn-train-52" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="churn-train-61" edge="1" parent="churn-train-governance" source="churn-train-52" target="churn-train-54" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="churn-train-62" edge="1" parent="churn-train-governance" source="churn-train-52" target="churn-train-13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=0.02;exitY=1;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1741.6" y="699" /></Array></mxGeometry></mxCell><mxCell id="churn-train-63" edge="1" parent="churn-train-governance" source="churn-train-54" target="churn-train-13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.75;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2140" y="438.5" /><mxPoint x="2140" y="699" /></Array></mxGeometry></mxCell><mxCell id="churn-train-64" edge="1" parent="churn-train-governance" source="churn-train-54" target="churn-train-57" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2279" y="419" /></Array></mxGeometry></mxCell><mxCell id="churn-train-65" edge="1" parent="churn-train-governance" source="churn-train-1" target="churn-train-50" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=0.5;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="70" y="20" /><mxPoint x="1539" y="20" /></Array></mxGeometry></mxCell><mxCell id="churn-train-66" edge="1" parent="churn-train-governance" source="churn-train-13" target="churn-train-1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;dashed=1;exitX=0;exitY=0.8;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1900" y="722" /><mxPoint x="1900" y="840" /><mxPoint x="70" y="840" /></Array></mxGeometry></mxCell><mxCell id="churn-train-info" parent="churn-train-0" value="churn-train-info" /><mxCell id="churn-train-infobox" parent="churn-train-info" style="text;html=1;spacing=20;spacingTop=-30;whiteSpace=wrap;overflow=hidden;rounded=1;fontSize=12;fontFamily=Helvetica;fillColor=#7EA6E0;strokeColor=none;arcSize=4;glass=0;shadow=0;opacity=25;" value="&lt;h1 style=&quot;line-height: 120%;&quot;&gt;&lt;font face=&quot;Verdana&quot; style=&quot;font-size: 18px;&quot;&gt;Customer Churn Training Flow&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;text-align: justify; line-height: 120%;&quot;&gt;&lt;font face=&quot;Verdana&quot;&gt;&lt;p&gt;Reference MLOps project that predicts which customers will churn, trained on the public IBM Telco Customer Churn dataset. This page covers how data arrives and how models are trained, validated, registered and approved. It spans the &lt;b&gt;Data&lt;/b&gt;, &lt;b&gt;Image&lt;/b&gt; and &lt;b&gt;Pipeline&lt;/b&gt; stacks and uses the shared buckets, Athena and notifications of the Common Infrastructure.&lt;/p&gt;&lt;p&gt;A &lt;b&gt;Data scientist&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➊&lt;/font&gt; runs the &lt;b&gt;IngestDataset Lambda&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➋&lt;/font&gt;, which downloads the dataset (optionally simulating a market drift) into the raw zone of the &lt;b&gt;Data Lake Bucket&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➌&lt;/font&gt;. The new file matches the &lt;b&gt;Raw Data Rule&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➍&lt;/font&gt;, which starts the &lt;b&gt;Glue Workflow&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➎&lt;/font&gt; after grouping files that arrive together.&lt;/p&gt;&lt;p&gt;The workflow runs the &lt;b&gt;Glue Crawler&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➏&lt;/font&gt;, which discovers the raw schema and registers it in the &lt;b&gt;Glue Data Catalog&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➑&lt;/font&gt;; when it succeeds, the &lt;b&gt;Curation Job&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➐&lt;/font&gt; reads the raw file, cleans and types every column and evaluates the data quality rules. If any rule fails the job fails and nothing downstream runs; otherwise it writes the curated data back to the data lake, where &lt;b&gt;Athena&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;⓫&lt;/font&gt; reads it through a table declared as code in the catalog.&lt;/p&gt;&lt;p&gt;A successful curation matches the &lt;b&gt;Training Triggers&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➒&lt;/font&gt;, which also run a weekly retraining in production, and starts the &lt;b&gt;SageMaker Pipeline&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➓&lt;/font&gt;. Its first step asks Athena for the latest curated data, validates it (columns, minimum rows, valid target) and splits it into train, validation and test sets. Then it computes a statistical baseline of the training data, trains the model and evaluates it on the test set. Every step runs the project's own image from the &lt;b&gt;Model Image Repository&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;⓬&lt;/font&gt;, tagged with a hash of its content, and leaves its outputs in the &lt;b&gt;Artifacts Bucket&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;⓭&lt;/font&gt;.&lt;/p&gt;&lt;p&gt;If the test ROC AUC is below the configured threshold the pipeline stops with an explicit failure. Otherwise it registers a new version in the &lt;b&gt;Model Registry&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;⓮&lt;/font&gt; with its metrics, its baseline and the exact image that trained it, waiting for manual approval.&lt;/p&gt;&lt;p&gt;The &lt;b&gt;Registry Rules&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;⓯&lt;/font&gt; send to the &lt;b&gt;Notifications Topic&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;⓰&lt;/font&gt; every new version waiting for approval and every failed pipeline execution. The data scientist reviews the metrics and approves the version; the approval reaches the &lt;b&gt;OnModelApproved Lambda&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;⓱&lt;/font&gt;, which publishes the approved model and its baseline as the &lt;b&gt;Deployment Contract (SSM)&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;⓲&lt;/font&gt; and emails the command to release it. Approving never deploys by itself: the inference stacks read that contract (see the Customer Churn Inference page).&lt;/p&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="2440" y="40" width="720" height="580" as="geometry" /></mxCell></root></mxGraphModel></diagram>
