0" y="620" /><mxPoint x="660" y="509" /></Array></mxGeometry></mxCell><mxCell id="churn-inference-57" edge="1" parent="churn-inference-batch" source="churn-inference-49" target="churn-inference-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=0.25;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.95;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="569.5" y="650" /><mxPoint x="404.1" y="650" /></Array></mxGeometry></mxCell><mxCell id="churn-inference-58" edge="1" parent="churn-inference-batch" source="churn-inference-5" target="churn-inference-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="churn-inference-59" edge="1" parent="churn-inference-batch" source="churn-inference-49" target="churn-inference-51" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="churn-inference-60" edge="1" parent="churn-inference-batch" source="churn-inference-51" target="churn-inference-12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=0.25;exitY=0;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1059.5" y="536.3" /></Array></mxGeometry></mxCell><mxCell id="churn-inference-61" edge="1" parent="churn-inference-batch" source="churn-inference-51" target="churn-inference-2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=0;exitY=0.85;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="846.3" /><mxPoint x="1000" y="1040" /><mxPoint x="110" y="1040" /><mxPoint x="110" y="509" /></Array></mxGeometry></mxCell><mxCell id="churn-inference-62" edge="1" parent="churn-inference-batch" source="churn-inference-51" target="churn-inference-20" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;dashed=1;exitX=1;exitY=0.85;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="846.3" /><mxPoint x="1160" y="1000" /><mxPoint x="1639" y="1000" /></Array></mxGeometry></mxCell><mxCell id="churn-inference-63" edge="1" parent="churn-inference-batch" source="churn-inference-51" target="churn-inference-53" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="churn-inference-64" edge="1" parent="churn-inference-batch" source="churn-inference-53" target="churn-inference-16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;curved=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Verdana;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1460" y="819" /><mxPoint x="1460" y="509" /></Array></mxGeometry></mxCell><mxCell id="churn-inference-info" parent="churn-inference-0" value="churn-inference-info" /><mxCell id="churn-inference-infobox" parent="churn-inference-info" style="text;html=1;spacing=20;spacingTop=-30;whiteSpace=wrap;overflow=hidden;rounded=1;fontSize=12;fontFamily=Helvetica;fillColor=#7EA6E0;strokeColor=none;arcSize=4;glass=0;shadow=0;opacity=25;" value="&lt;h1 style=&quot;line-height: 120%;&quot;&gt;&lt;font face=&quot;Verdana&quot; style=&quot;font-size: 18px;&quot;&gt;Customer Churn Inference Flow&lt;/font&gt;&lt;/h1&gt;&lt;div style=&quot;text-align: justify; line-height: 120%;&quot;&gt;&lt;font face=&quot;Verdana&quot;&gt;&lt;p&gt;How approved churn models are served: online through an HTTP API backed by a monitored real-time endpoint (&lt;b&gt;Endpoint&lt;/b&gt; stack), and in batch for every active customer (&lt;b&gt;Batch&lt;/b&gt; stack). Both only use models a person approved, read from the deployment contract written by the training flow.&lt;/p&gt;&lt;p&gt;Online, a &lt;b&gt;Client system&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➊&lt;/font&gt; calls the &lt;b&gt;HTTP API&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➋&lt;/font&gt;, which is open to anyone (no authentication, this is a learning project) but limited to a number of requests per second. The &lt;b&gt;Predict Lambda&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➌&lt;/font&gt; validates the customers in the request, normalizes their categories and sends them to the &lt;b&gt;SageMaker Endpoint&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➍&lt;/font&gt; in the exact column order the model expects, returning each customer's churn probability.&lt;/p&gt;&lt;p&gt;The endpoint is created from the &lt;b&gt;Deployment Contract (SSM)&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➎&lt;/font&gt; when its stack is deployed: releasing a newly approved version is redeploying that stack, which shifts traffic to the new model with a blue/green update and rolls back automatically if errors appear. It runs the image of that version from the &lt;b&gt;Model Image Repository&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➏&lt;/font&gt; on a single small instance.&lt;/p&gt;&lt;p&gt;The endpoint copies requests and responses to the &lt;b&gt;Artifacts Bucket&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➐&lt;/font&gt;. Every hour, the &lt;b&gt;DataDrift Lambda&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➑&lt;/font&gt; reads that captured traffic, compares the distribution of every feature with the reference profile computed when the model was trained (Population Stability Index) and writes a drift report; it replaces SageMaker Model Monitor, which no longer accepts new customers. &lt;b&gt;CloudWatch Alarms&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➒&lt;/font&gt; watch the endpoint errors, its latency and the drift measured by the Lambda, and notify the &lt;b&gt;Notifications Topic&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(0, 127, 255);&quot;&gt;➓&lt;/font&gt;; a drift alarm is the signal to retrain.&lt;/p&gt;&lt;p&gt;In batch, the &lt;b&gt;Daily Schedule&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➊&lt;/font&gt; (production only) runs the &lt;b&gt;BatchScoring Lambda&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➋&lt;/font&gt;, which reads the approved model from the &lt;b&gt;Deployment Contract (SSM)&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➌&lt;/font&gt; and asks &lt;b&gt;Athena&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➍&lt;/font&gt; to export the active customers of the latest curated data from the &lt;b&gt;Data Lake Bucket&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➎&lt;/font&gt; into the &lt;b&gt;Artifacts Bucket&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➏&lt;/font&gt;.&lt;/p&gt;&lt;p&gt;It then starts a &lt;b&gt;Batch Transform&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➐&lt;/font&gt; job with the approved model, which runs its image from the &lt;b&gt;Model Image Repository&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➑&lt;/font&gt;, scores every customer without sending the customer id to the model, joins the id back to each probability and writes the results to the predictions zone of the data lake, where Athena can query the customers most likely to churn. If the job fails, the &lt;b&gt;Transform Failed Rule&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➒&lt;/font&gt; notifies the &lt;b&gt;Notifications Topic&lt;/b&gt; &lt;font style=&quot;font-size: 18px; color: rgb(103, 171, 159);&quot;&gt;➓&lt;/font&gt;.&lt;/p&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1"><mxGeometry x="1820" y="40" width="720" height="530" as="geometry" /></mxCell></root></mxGraphModel></diagram>
</mxfile>
